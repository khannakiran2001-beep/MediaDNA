# Copy to .env and fill in to enable live integrations.
# Everything works without these (local + deterministic fallbacks).

# Hugging Face Inference API (captioning / detection / embeddings)
HF_TOKEN=
HF_CAPTION_MODEL=Salesforce/blip-image-captioning-large
HF_DETECTION_MODEL=facebook/detr-resnet-50
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Backblaze B2 (permanent storage via the official genblaze_s3 SDK).
# Without these, storage falls back to a local genblaze StorageBackend.
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET_NAME=
B2_BUCKET_ID=

# Genblaze generation providers (optional). The real Genblaze Pipeline runs
# with the built-in image provider (HF -> Pollinations -> procedural) out of
# the box. To use official sponsor providers, install the extra and set a key:
#   pip install "genblaze[gmicloud]"   ->  GMI_API_KEY
#   pip install "genblaze[video]"      ->  GMICloud + Google + Runway + Luma + Decart
# GMI_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# RUNWAYML_API_SECRET=
# LUMAAI_API_KEY=
# NVIDIA_API_KEY=

# Auth (email OTP). Without SMTP, OTP runs in dev mode (code shown in-app).
SECRET_KEY=change-me-in-production
# Comma-separated admin emails. If blank, the FIRST registered user is admin.
ADMIN_EMAILS=
# SMTP for real OTP emails (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=MediaDNA <no-reply@mediadna.local>

# Optional: switch to Postgres + pgvector for production
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/mediadna
